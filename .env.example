# Supabase transaction pooler URL, server-side only
DATABASE_URL=
# Optional database CA override in PEM format, with real or escaped newlines. Supabase's production CA is bundled.
DATABASE_CA_CERT=
# Optional private profile photo storage. Use a server-only Supabase secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile widget keys. Both are required on Vercel.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin sign-in credentials. Password hash format is hex salt:hex scrypt hash.
MODERATION_USERNAME=
MODERATION_PASSWORD_HASH=
# Independent random value of at least 32 characters.
MODERATION_SESSION_SECRET=
# Optional admin hostname without a scheme or port, or vercel-branch with Vercel Standard Protection.
# Keep blank for the standard local sign-in route.
MODERATION_HOST=
# Optional separate key for hashing signup rate-limit addresses
RATE_LIMIT_SECRET=
# Independent secret (at least 32 characters) for the daily Supabase Cron request.
RETENTION_SECRET=
